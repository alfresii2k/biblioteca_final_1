# Copia este archivo como ".env" y ajusta los valores a tu entorno.
# La app funciona sin .env (usa estos mismos valores por defecto),
# pero en producción SIEMPRE debes definir tu propio SECRET_KEY.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biblioteca_colegio

SECRET_KEY=cambia-esta-clave-por-una-generada-con-secrets-token-hex
SESSION_LIFETIME_MINUTES=30
FLASK_DEBUG=True
